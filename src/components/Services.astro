---
import ServiceItem from './ServiceItem.astro';
import { services } from '../data/services';
---

<section id="uslugi" class="features" aria-labelledby="h-uslugi" data-variant="solutions">
  <img src="/img/glyph-d.svg" alt="" aria-hidden="true" loading="lazy" width="500" height="523" draggable="false" />
  <h2 id="h-uslugi">Co robimy, żeby było dobrze</h2>
  <ol class="features-list" role="list">
    {services.map((service, index) => <ServiceItem service={service} number={index + 1} />)}
  </ol>
</section>
