---
import type { Service } from '../data/services';

interface Props {
  service: Service;
  number: number;
}

const { service, number } = Astro.props;
const tools = service.tools.map(tool => ({
  ...tool,
  tabId: `tab-${service.id}-${tool.id}`,
  panelId: `panel-${service.id}-${tool.id}`,
}));
---

<li>
  <span class="hot decorative" aria-hidden="true">{number}</span>
  <div class="stack">
    <h3>{service.title}</h3>
    {service.paragraphs.map(paragraph => (
      <p>{service.highlight
        ? paragraph.split(service.highlight).map((part, index) => (
          <>{index > 0 && <mark>{service.highlight}</mark>}{part}</>
        ))
        : paragraph}</p>
    ))}
  </div>
  <div class="stack" data-service-tools style="--gutter: var(--space-m);">
    <span class="eyebrow">{service.toolsLabel ?? 'Nasze narzędzia'}</span>
    <div class="cluster" role="tablist">
      {tools.map((tool, index) => (
        <button type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} aria-controls={tool.panelId} id={tool.tabId} class="tab-btn">
          <span class="grid-overlap">
            <span class="f-disp">{tool.label}</span>
            <span class="f-text" aria-hidden="true">{tool.label}</span>
          </span>
        </button>
      ))}
    </div>
    <div class="panels-container">
      {tools.map((tool, index) => (
        <div id={tool.panelId} role="tabpanel" aria-labelledby={tool.tabId} class="details-wrapper" aria-hidden={index === 0 ? 'false' : 'true'}>
          <div class="details-content">
            <span class="eyebrow">{tool.label}</span>
            <p>{tool.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</li>

<script>
  const initServiceTools = () => {
    const tabWrappers = document.querySelectorAll<HTMLElement>('[data-service-tools]');

    tabWrappers.forEach(wrapper => {
      if (wrapper.dataset.serviceToolsInitialized) return;

      const tabs = wrapper.querySelectorAll<HTMLButtonElement>('[role="tab"]');
      const panels = wrapper.querySelectorAll<HTMLElement>('[role="tabpanel"]');
      if (tabs.length === 0 || panels.length === 0) return;
      wrapper.dataset.serviceToolsInitialized = 'true';

      let selectedIndex = 0;
      let visibleIndex = 0;
      let switching = false;
      let disposed = false;

      const finishTransition = (panel: HTMLElement) => Promise.allSettled(
        panel.getAnimations().map(animation => animation.finished)
      );

      const switchPanel = async () => {
        if (switching) return;
        switching = true;

        try {
          while (!disposed && visibleIndex !== selectedIndex) {
            const outgoing = panels[visibleIndex];
            outgoing.setAttribute('aria-hidden', 'true');
            await finishTransition(outgoing);
            if (disposed) return;

            visibleIndex = selectedIndex;
            const incoming = panels[visibleIndex];
            incoming.setAttribute('aria-hidden', 'false');
            await finishTransition(incoming);
          }
        } finally {
          switching = false;
        }
      };

      const activateTab = (index: number) => {
        if (index === selectedIndex) return;
        selectedIndex = index;

        tabs.forEach((tab, tabIndex) => {
          const selected = tabIndex === index;
          tab.setAttribute('aria-selected', String(selected));
          tab.tabIndex = selected ? 0 : -1;
        });
        void switchPanel();
      };

      document.addEventListener('astro:before-swap', () => { disposed = true; }, { once: true });

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => activateTab(index));
        tab.addEventListener('keydown', event => {
          let nextIndex: number;
          switch (event.key) {
            case 'ArrowRight': nextIndex = (index + 1) % tabs.length; break;
            case 'ArrowLeft': nextIndex = (index - 1 + tabs.length) % tabs.length; break;
            case 'Home': nextIndex = 0; break;
            case 'End': nextIndex = tabs.length - 1; break;
            default: return;
          }
          event.preventDefault();
          activateTab(nextIndex);
          tabs[nextIndex].focus();
        });
      });
    });
  };

  document.addEventListener('astro:page-load', initServiceTools);
</script>

<style>
  @layer blocks {
    /* TAB BUTTONS */
    [role="tablist"] {
      --cluster-gap-y: var(--space-xs);
      --cluster-gap-x: var(--space-xs);
      --cluster-justify: flex-start;
    }

    .tab-btn {
      display: inline-flex;
      align-items: center;
      justify-content: flex-start;
      flex: 0 0 auto;
      gap: var(--space-xs);
      cursor: pointer;
      background: transparent;
      color: inherit;
      font-size: var(--step-1);
      line-height: var(--lh-small);
      letter-spacing: -0.02em;
      text-transform: uppercase;
      text-align: start;
      white-space: nowrap;
      border: 0;
      padding: 0;
      transition: color var(--duration-short) var(--ease-out-3);
    }

    .tab-btn .grid-overlap {
      justify-items: start;
    }

    .tab-btn:not(:last-child)::after {
      content: '\005C' / '';
      color: var(--c-superd);
      font-family: var(--font-text);
      font-weight: var(--font-medium);
      pointer-events: none;
    }

    .tab-btn .f-text {
      clip-path: inset(0 0 0 0);
    }

    .tab-btn .f-disp {
      clip-path: inset(0 100% 0 0);
    }

    .tab-btn:is(:hover, :focus-visible, [aria-selected="true"]) .f-text {
      clip-path: inset(0 0 0 100%);
    }

    .tab-btn:is(:hover, :focus-visible, [aria-selected="true"]) .f-disp {
      clip-path: inset(0 0 0 0);
    }

    .tab-btn[aria-selected="true"] {
      color: var(--c-hot);
    }

    /* 2. PANELS CONTAINER & DRAWER ANIMATION */
    .panels-container {
      display: grid;
      align-items: start;
    }

    .details-wrapper {
      /* All cards reserve their full height; only their visible area animates. */
      grid-area: 1 / 1;
      min-inline-size: 0;
      clip-path: inset(0 0 100% 0);
      pointer-events: none;
      transition: clip-path var(--duration-panel) var(--ease-circ-in-out);
    }

    .details-wrapper[aria-hidden="false"] {
      clip-path: inset(0);
      pointer-events: auto;
    }

    .details-content {
      overflow: hidden;
      background-color: var(--c-super);
      margin: 0;
      padding-inline: var(--space-m);
      padding-block: var(--space-m);
    }

    .details-content > .eyebrow {
      display: block;
      margin-block-end: var(--space-xs);
    }

    @media (prefers-reduced-motion: reduce) {
      .tab-btn :is(.f-text, .f-disp) {
        transition: none;
      }
    }
  }
</style>
