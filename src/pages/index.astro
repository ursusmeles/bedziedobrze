---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>

<div class="font-test full-bleed-wrapper">
  <div>
  <h2>Ferro IV (Base 400)</h2>
  <p class="ferro">Zażółć gęślą jaźń. ZAŻÓŁĆ GĘŚLĄ JAŹŃ.</p>

  <h2>Space Grotesk (Variable Weights)</h2>
  <div class="grotesk">
    <p class="w-300">Light (300): Zażółć gęślą jaźń. 0123456789</p>
    <p class="w-400">Regular (400): Zażółć gęślą jaźń. 0123456789</p>
    <p class="w-500">Medium (500): Zażółć gęślą jaźń. 0123456789</p>
    <p class="w-600">Semibold (600): Zażółć gęślą jaźń. 0123456789</p>
  </div>
  </div>
</div>

<style>
  .font-test {
    padding: 2rem;
    background-color: #111;
    color: #fff;
  }
  h2 {
    font-family: system-ui, sans-serif;
    color: #888;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-block-start: 2rem;
    margin-block-end: 1rem;
  }
  .ferro {
    font-family: 'Ferro IV', sans-serif;
    font-weight: 400;
    font-size: 2.5rem;
  }
  .grotesk p {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.5rem;
    margin-block: 0.5rem;
  }
  .w-300 { font-weight: 300; }
  .w-400 { font-weight: 400; }
  .w-500 { font-weight: 500; }
  .w-600 { font-weight: 600; }
</style>
</BaseLayout>