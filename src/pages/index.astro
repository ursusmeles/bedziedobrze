              <span class="f-text" aria-hidden="true">ads</span>
            </span>
          </button>
          <button role="tab" aria-selected="false" aria-controls="panel-strat-analityka" id="tab-strat-analityka" class="tab-btn">
            <span class="grid-overlap">
              <span class="f-disp">analityka</span>
              <span class="f-text" aria-hidden="true">analityka</span>
            </span>
          </button>
          <button role="tab" aria-selected="false" aria-controls="panel-strat-offline" id="tab-strat-offline" class="tab-btn">
            <span class="grid-overlap">
              <span class="f-disp">offline</span>
              <span class="f-text" aria-hidden="true">offline</span>
            </span>
          </button>
        </div>
        <div class="panels-container">
          <div id="panel-strat-strategia" role="tabpanel" aria-labelledby="tab-strat-strategia" class="details-wrapper" aria-hidden="true">
            <div class="details-content"><p>Treść dla strategii...</p></div>
          </div>
          <div id="panel-strat-design" role="tabpanel" aria-labelledby="tab-strat-design" class="details-wrapper" aria-hidden="true">
            <div class="details-content"><p>Treść dla designu...</p></div>
          </div>
          <div id="panel-strat-ads" role="tabpanel" aria-labelledby="tab-strat-ads" class="details-wrapper" aria-hidden="true">
            <div class="details-content"><p>Treść dla ads...</p></div>
          </div>
          <div id="panel-strat-analityka" role="tabpanel" aria-labelledby="tab-strat-analityka" class="details-wrapper" aria-hidden="true">
