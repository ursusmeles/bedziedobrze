            </span>
          </button>
          <button role="tab" aria-selected="false" aria-controls="panel-wideo-reels" id="tab-wideo-reels" class="tab-btn">
            <span class="grid-overlap">
              <span class="f-disp">reels</span>
              <span class="f-text" aria-hidden="true">reels</span>
            </span>
          </button>
          <button role="tab" aria-selected="false" aria-controls="panel-wideo-streaming" id="tab-wideo-streaming" class="tab-btn">
            <span class="grid-overlap">
              <span class="f-disp">streaming</span>
              <span class="f-text" aria-hidden="true">streaming</span>
            </span>
          </button>
        </div>
        <div class="panels-container">
          <div id="panel-wideo-podkasty" role="tabpanel" aria-labelledby="tab-wideo-podkasty" class="details-wrapper" aria-hidden="true">
            <div class="details-content"><p>Treść dla podkastów...</p></div>
          </div>
          <div id="panel-wideo-reels" role="tabpanel" aria-labelledby="tab-wideo-reels" class="details-wrapper" aria-hidden="true">
            <div class="details-content"><p>Treść dla reels...</p></div>
          </div>
          <div id="panel-wideo-streaming" role="tabpanel" aria-labelledby="tab-wideo-streaming" class="details-wrapper" aria-hidden="true">
            <div class="details-content"><p>Treść dla streamingu...</p></div>
          </div>
        </div>
      </div>
    </li>

    <!-- SERVICE 3 -->
    <li>
      <span class="hot decorative" aria-hidden="true">3</span>
      <h3>Web design &&nbsp;development</h3>
      <p>Zbudujemy ultraszybką stronę internetową lub sklep e-commerce tak, by rzeczywiście sprzedawały. Bez kompromisów w kwestii user experience, pozycjonowania, responsywności i dostępności.</p>
      <div class="stack" style="--gutter: var(--space-m);">
        <div class="cluster" role="tablist">
          <button role="tab" aria-selected="false" aria-controls="panel-web-css" id="tab-web-css" class="tab-btn">
            <span class="grid-overlap">
              <span class="f-disp">css/html</span>
              <span class="f-text" aria-hidden="true">css/html</span>
            </span>
          </button>
          <button role="tab" aria-selected="false" aria-controls="panel-web-ux" id="tab-web-ux" class="tab-btn">
            <span class="grid-overlap">
              <span class="f-disp">ux/ui</span>
              <span class="f-text" aria-hidden="true">ux/ui</span>
            </span>
          </button>
          <button role="tab" aria-selected="false" aria-controls="panel-web-seo" id="tab-web-seo" class="tab-btn">
            <span class="grid-overlap">
              <span class="f-disp">seo</span>
              <span class="f-text" aria-hidden="true">seo</span>
            </span>
          </button>
          <button role="tab" aria-selected="false" aria-controls="panel-web-cms" id="tab-web-cms" class="tab-btn">
            <span class="grid-overlap">
              <span class="f-disp">cms</span>
              <span class="f-text" aria-hidden="true">cms</span>
            </span>
          </button>
        </div>
        <div class="panels-container">
          <div id="panel-web-css" role="tabpanel" aria-labelledby="tab-web-css" class="details-wrapper" aria-hidden="true">
            <div class="details-content"><p>Treść dla css/html...</p></div>
          </div>
          <div id="panel-web-ux" role="tabpanel" aria-labelledby="tab-web-ux" class="details-wrapper" aria-hidden="true">
            <div class="details-content"><p>Treść dla ux/ui...</p></div>
          </div>
          <div id="panel-web-seo" role="tabpanel" aria-labelledby="tab-web-seo" class="details-wrapper" aria-hidden="true">
            <div class="details-content"><p>Treść dla seo...</p></div>
          </div>
          <div id="panel-web-cms" role="tabpanel" aria-labelledby="tab-web-cms" class="details-wrapper" aria-hidden="true">
            <div class="details-content"><p>Treść dla cms...</p></div>
          </div>
        </div>
      </div>
    </li>
  </ol>
<script>
  document.addEventListener('astro:page-load', () => {
    const tabWrappers = document.querySelectorAll('.stack'); 

    tabWrappers.forEach(wrapper => {
      const tabs = wrapper.querySelectorAll('[role="tab"]');
      const panels = wrapper.querySelectorAll('[role="tabpanel"]');
      let transitionTimeout: any;

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const isSelected = tab.getAttribute('aria-selected') === 'true';
          const anyOpen = Array.from(tabs).some(t => t.getAttribute('aria-selected') === 'true');

          // 1. Immediately reset button states and close all panels
          tabs.forEach(t => t.setAttribute('aria-selected', 'false'));
          panels.forEach(p => p.setAttribute('aria-hidden', 'true'));
          
          // Clear any rapid-fire click timeouts
          clearTimeout(transitionTimeout);

          // 2. If we are opening a new tab
          if (!isSelected) {
            tab.setAttribute('aria-selected', 'true'); // Highlight button immediately
            const targetPanel = wrapper.querySelector(`#${tab.getAttribute('aria-controls')}`);
            
            if (targetPanel) {
              if (anyOpen) {
                // If something was open, wait for it to close (400ms) before opening the new one
                transitionTimeout = setTimeout(() => {
                  targetPanel.setAttribute('aria-hidden', 'false');
                }, 400); 
              } else {
                // If nothing was open, open instantly
                targetPanel.setAttribute('aria-hidden', 'false');
              }
            }
          }
        });
      });
    });
  });
</script>
</section>
<!-- LICZBY -->
<section class="full-bleed-wrapper liczby-banner" aria-label="Liczby" id="liczby">
<img src="/img/glyph-rp8.svg" alt="RP8" class="liczby-rp8" draggable="false" />
<div class="card">...</div>
