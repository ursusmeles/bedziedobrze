---
import { ClientRouter, slide } from 'astro:transitions';
import '../styles/global.css';
import Header from '../layouts/Header.astro';
import Footer from '../layouts/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: 'website' | 'article';
}

const {
  title = "będzie/dobrze — gdańskie studio kreatywne",
  description = "Wspieramy Cię w skalowaniu Twojego biznesu. Tworzymy strony i sklepy internetowe, produkujemy wideo i fotografię, prowadzimy kampanie reklamowe.",
  image = "/og-image.jpg",
  imageAlt = "będzie/dobrze — gdańskie studio kreatywne",
  imageWidth = 1200,
  imageHeight = 630,
  type = "website"
} = Astro.props;

const siteName = "będzie\\dobrze";
const siteURL = Astro.site!;
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const imageURL = new URL(image, siteURL);
const organizationID = new URL('/#organization', siteURL).href;
const websiteID = new URL('/#website', siteURL).href;
const webpageID = `${canonicalURL.href}#webpage`;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      "@type": "ProfessionalService",
      "telephone": "+48698673078",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Rzeczpospolitej 8/215",
        "addressLocality": "Gdańsk",
        "postalCode": "80-369",
        "addressCountry": "PL"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 54.4004146,
        "longitude": 18.591991
      },
      "knowsAbout": [
        "Business Strategy",
        "Web Design",
        "Performance Marketing",
        "Video Production",
        "Brand Identity"
      ],
      "founder": [
        {
          "@type": "Person",
          "name": "Mateusz Nowak",
          "jobTitle": "Co-founder & Strateg",
          "description": "Ekspert od skalowania biznesu, strategii wizerunkowych i projektowania webowego. Doświadczony manager i szkoleniowiec.",
          "url": "https://h62.pl",
          "sameAs": [
            "https://www.linkedin.com/in/mateuszdnowak/",
            "https://github.com/ursusmeles/",
            "https://rpg.h62.pl/"
          ],
          "knowsAbout": [
            "Business Strategy",
            "Web Design & Development",
            "Performance Marketing",
            "Brand Culture",
            "TTRPG Design"
          ]
        },
        {
          "@type": "Person",
          "name": "Mikołaj Zbrzeźniak",
          "jobTitle": "Co-founder & Video Producer",
          "description": "Producent wideo i strateg wizualny. Ekspert przekładania założeń biznesowych na angażujący obraz i dźwięk.",
          "url": "https://mikthecreator.pl",
          "sameAs": [
            "https://www.linkedin.com/in/miko%C5%82aj-zbrze%C5%BAniak-2b7294215/",
            "https://www.instagram.com/mik.thecreator/"
          ],
          "knowsAbout": [
            "Video Production",
            "Visual Strategy",
            "Photography",
            "Studio Recording"
          ]
        }
      ],
      '@id': organizationID,
      name: siteName,
      url: siteURL.href,
      logo: new URL('/web-app-manifest-512x512.png', siteURL).href,
      image: imageURL.href,
      description,
    },
    {
      '@type': 'WebSite',
      '@id': websiteID,
      url: siteURL.href,
      name: siteName,
      publisher: { '@id': organizationID },
      inLanguage: 'pl-PL',
    },
    {
      '@type': 'WebPage',
      '@id': webpageID,
      url: canonicalURL.href,
      name: title,
      description,
      isPartOf: { '@id': websiteID },
      about: { '@id': organizationID },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: imageURL.href,
        width: imageWidth,
        height: imageHeight,
        caption: imageAlt,
      },
      inLanguage: 'pl-PL',
    },
  ],
};

const pageTransition = slide();
for (const direction of Object.values(pageTransition)) {
  for (const state of ['old', 'new'] as const) {
    const animations = direction[state];
    direction[state] = (Array.isArray(animations) ? animations : [animations]).map(animation => ({
      ...animation,
      duration: animation.name.includes('Fade') ? 'var(--duration-short)' : 'var(--duration-wipe)',
      easing: 'var(--ease-out-3)',
      delay: 'var(--duration-instant)',
    }));
  }
}
---

<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Basic SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- GEO & Local SEO -->
  <meta name="geo.region" content="PL-PM" />
  <meta name="geo.placename" content="Gdańsk" />
  <meta name="geo.position" content="54.400414649565285;18.591991085026432">
  <meta name="ICBM" content="54.400414649565285, 18.591991085026432">

  <!-- Open Graph -->
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={imageURL} />
  <meta property="og:image:width" content={imageWidth} />
  <meta property="og:image:height" content={imageHeight} />
  <meta property="og:image:alt" content={imageAlt} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content="pl_PL" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageURL} />
  <meta name="twitter:image:alt" content={imageAlt} />

  <!-- Favicons -->
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="będzie" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Font Preloading -->
  <link rel="preload" href="/fonts/space-grotesk.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/ferro-iv.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Astro View Transitions (Smooth page routing) -->
  <ClientRouter />

  <!-- Local Business Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  <!-- Main script -->
  <script src="../scripts/main.ts"></script>
</head>
<body>
  <!-- A11y Skip Link -->
  <a href="#main" class="skip-link visually-hidden-focusable">Przejdź do treści</a>

  <Header />

  <main class="layout-grid" id="main" tabindex="-1" transition:animate={pageTransition}>
    <slot />
  </main>

  <Footer />
</body>
</html>
